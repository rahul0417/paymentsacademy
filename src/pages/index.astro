---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TopicCard from '../components/TopicCard.astro';
import DailyNugget from '../components/DailyNugget.astro';
import { themes, getTopicsByTheme } from '../data/themes';

const { topicsByTheme } = await getTopicsByTheme();
---

<BaseLayout
  title="PaymentsAcademy"
  description="A free, open knowledge base that explains the payments ecosystem — from card swipes to cross-border settlements — in plain language."
>
  <Hero />

  <DailyNugget />

  <!-- Topics Grid Section -->
  <section id="topics" class="topics-section">
    <div class="topics-container">
      <div class="topics-header">
        <h2 class="topics-heading">Topics</h2>
        <p class="topics-intro">
          Explore the payments ecosystem, one concept at a time. Each topic is a
          self-contained guide written in plain language.
        </p>
      </div>

      {themes.map((theme, themeIndex) => {
        const publishedTopics = topicsByTheme.get(theme.name) || [];

        return (
          <div
            class="theme-group"
            style={`animation-delay: ${0.1 + themeIndex * 0.08}s;`}
          >
            <div class="theme-header">
              <h3 class="theme-name">{theme.name}</h3>
              <p class="theme-description">{theme.description}</p>
            </div>

            <div class="topic-grid">
              {publishedTopics.map((topic) => (
                <div class="topic-card-wrapper" data-topic-slug={topic.id}>
                  <TopicCard
                    title={topic.data.title}
                    description={topic.data.description}
                    theme={topic.data.theme}
                    readingTime={topic.data.readingTime}
                    href={`/topics/${topic.id}`}
                  />
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  /* Topics Section */
  .topics-section {
    padding: 2rem 1.5rem 5rem;
  }

  .topics-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .topics-header {
    text-align: center;
    margin-bottom: 3.5rem;
    animation: fadeInUp 0.6s ease both;
  }

  .topics-heading {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .topics-intro {
    font-size: 1.05rem;
    color: var(--color-text-medium);
    max-width: 32rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Theme Groups */
  .theme-group {
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s ease both;
  }

  .theme-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-pale-mint-dark);
  }

  .theme-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin-bottom: 0.25rem;
  }

  .theme-description {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  /* Topic Grid */
  .topic-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .topic-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Dark mode */
  html[data-theme="dark"] {
    .topics-heading {
      color: var(--color-night-text);
    }

    .topics-intro {
      color: var(--color-night-text-muted);
    }

    .theme-name {
      color: var(--color-night-text);
    }

    .theme-description {
      color: var(--color-night-text-muted);
    }

    .theme-header {
      border-bottom-color: var(--color-night-elevated);
    }
  }

  /* Responsive */
  @media (min-width: 768px) {
    .topics-section {
      padding: 3rem 2rem 6rem;
    }
  }

  /* Progress badges on topic cards */
  .topic-card-wrapper {
    position: relative;
  }

  .topic-card-badges {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.25rem;
    z-index: 1;
  }

  .card-badge-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    line-height: 1;
  }

  .card-badge-read {
    background-color: var(--color-pale-mint);
    color: var(--color-racing-green);
  }

  .card-badge-quiz {
    background-color: var(--color-peach-light);
    color: var(--color-peach-dark);
  }

  html[data-theme="dark"] {
    .card-badge-read {
      background-color: var(--color-night-elevated);
      color: var(--color-night-text);
    }

    .card-badge-quiz {
      background-color: rgba(255, 183, 77, 0.2);
      color: var(--color-night-accent);
    }
  }
</style>

<script>
  import { loadProgress } from '../data/progress';

  // Show progress badges on topic cards
  try {
    const state = loadProgress();
    document.querySelectorAll('.topic-card-wrapper[data-topic-slug]').forEach((wrapper) => {
      const slug = (wrapper as HTMLElement).dataset.topicSlug || '';
      const isRead = !!state.topicsRead[slug];
      const quizResult = state.quizResults?.[slug];
      const quizPassed = quizResult?.passed;

      if (isRead || quizPassed) {
        const badges = document.createElement('div');
        badges.className = 'topic-card-badges';
        if (isRead) {
          badges.innerHTML += '<span class="card-badge-icon card-badge-read" title="Read">&#10003;</span>';
        }
        if (quizPassed) {
          badges.innerHTML += '<span class="card-badge-icon card-badge-quiz" title="Quiz passed">&#9733;</span>';
        }
        wrapper.appendChild(badges);
      }
    });
  } catch {}
</script>
