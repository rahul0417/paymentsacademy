---
import { getCollection } from 'astro:content';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;

const allTopics = await getCollection('topics');
const relatedTopics = slugs
  .map((slug) => allTopics.find((t) => t.id === slug))
  .filter((t): t is NonNullable<typeof t> => t != null);

const themeColors: Record<string, string> = {
  'Foundations': 'var(--color-sage)',
  'Transaction Lifecycle': 'var(--color-copper)',
  'Card Ecosystem': 'var(--color-amber)',
  'Non-Card Payments': 'var(--color-sage-light)',
  'Moving Money': 'var(--color-copper-light)',
  'Products & Use Cases': 'var(--color-amber-light)',
  'Trust & Compliance': 'var(--color-stone)',
};
---

{relatedTopics.length > 0 && (
  <section class="related-topics">
    <h2 class="related-heading">Continue Reading</h2>
    <div class="related-grid">
      {relatedTopics.map((topic) => (
        <a href={`/topics/${topic.id}`} class="related-card">
          <span class="related-badge" style={`color: ${themeColors[topic.data.theme] || 'var(--color-stone)'}`}>
            {topic.data.theme}
          </span>
          <h3 class="related-title">{topic.data.title}</h3>
          <p class="related-desc">{topic.data.description}</p>
          <span class="related-meta">{topic.data.readingTime}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-topics {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-parchment);
  }

  .related-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-charcoal);
    margin-bottom: 1.5rem;
    margin-top: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background-color: var(--color-ivory);
    border: 1px solid var(--color-parchment);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-copper-light);
    box-shadow: 0 4px 16px rgba(184, 115, 51, 0.08);
  }

  .related-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .related-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-charcoal);
    margin: 0;
    line-height: 1.3;
  }

  .related-desc {
    font-size: 0.85rem;
    color: var(--color-stone);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-meta {
    font-size: 0.75rem;
    color: var(--color-stone-light);
    margin-top: auto;
  }

  @media (prefers-color-scheme: dark) {
    .related-topics {
      border-top-color: var(--color-night-elevated);
    }

    .related-heading {
      color: var(--color-night-text);
    }

    .related-card {
      background-color: var(--color-night-surface);
      border-color: var(--color-night-elevated);
    }

    .related-card:hover {
      border-color: var(--color-night-copper);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .related-title {
      color: var(--color-night-text);
    }

    .related-desc {
      color: var(--color-night-text-muted);
    }

    .related-meta {
      color: var(--color-night-text-muted);
    }
  }
</style>
