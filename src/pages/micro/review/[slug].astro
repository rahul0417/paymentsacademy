---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MicroLearningDeck from '../../../components/MicroLearningDeck.astro';
import { getAllMicroLessons } from '../../../data/microlearning';
import { getQuizBySlug } from '../../../data/quizzes';

export function getStaticPaths() {
  const lessons = getAllMicroLessons();
  return lessons.map((lesson) => ({
    params: { slug: lesson.topicSlug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const quiz = getQuizBySlug(lesson.topicSlug);
const quizQuestions = quiz?.questions ?? [];
---

<BaseLayout title={`Micro Learning: ${lesson.topicTitle}`} description={`Learn about ${lesson.topicTitle} in a structured, slide-by-slide format.`}>
  <div class="review-page">
    <div class="review-page-header">
      <a href={`/topics/${lesson.topicSlug}`} class="review-back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 4l-4 4 4 4" />
        </svg>
        Back to {lesson.topicTitle}
      </a>
      <span class="review-page-badge">{lesson.theme}</span>
    </div>

    <MicroLearningDeck
      topicSlug={lesson.topicSlug}
      topicTitle={lesson.topicTitle}
      slides={lesson.slides}
      quizQuestions={quizQuestions}
    />
  </div>
</BaseLayout>

<style>
  .review-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .review-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .review-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-text-light);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .review-back-link:hover {
    color: var(--color-racing-green);
  }

  .review-page-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  html[data-theme="dark"] {
    .review-back-link {
      color: var(--color-night-text-muted);
    }

    .review-back-link:hover {
      color: var(--color-night-accent);
    }

    .review-page-badge {
      color: var(--color-night-text);
      background-color: var(--color-night-surface);
    }
  }
</style>
