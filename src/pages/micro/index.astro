---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { themes, getTopicsByTheme } from '../../data/themes';
import { getAllQuizSlugs } from '../../data/quizzes';
import { getAllFlashcardSlugs, getFlashcardsBySlug } from '../../data/flashcards';

const { topicsByTheme } = await getTopicsByTheme();
const quizSlugs = getAllQuizSlugs();
const flashcardSlugs = getAllFlashcardSlugs();

const groupedTopics = themes
  .map((theme) => {
    const topics = topicsByTheme.get(theme.name) || [];
    return {
      theme: theme.name,
      topics: topics.map((t) => {
        const fc = getFlashcardsBySlug(t.id);
        return {
          slug: t.id,
          title: t.data.title,
          hasQuiz: quizSlugs.includes(t.id),
          hasFlashcards: flashcardSlugs.includes(t.id),
          cardCount: fc?.cards.length ?? 0,
        };
      }),
    };
  })
  .filter((g) => g.topics.some((t) => t.hasFlashcards || t.hasQuiz));

const topicData = JSON.stringify(groupedTopics.flatMap((g) =>
  g.topics.filter((t) => t.hasFlashcards || t.hasQuiz).map((t) => ({
    slug: t.slug,
    hasFlashcards: t.hasFlashcards,
    hasQuiz: t.hasQuiz,
  }))
));
---

<BaseLayout title="Review Hub" description="Review flashcards and quizzes across all payments topics.">
  <div class="hub-page">
    <header class="hub-header">
      <h1 class="hub-title">Review Hub</h1>
      <p class="hub-desc">Reinforce your knowledge with flashcards and quizzes across all topics.</p>
    </header>

    <div class="hub-themes" data-topics={topicData}>
      {groupedTopics.map(({ theme, topics }) => {
        const reviewableTopics = topics.filter((t) => t.hasFlashcards || t.hasQuiz);
        if (reviewableTopics.length === 0) return null;

        return (
          <section class="hub-theme-section">
            <h2 class="hub-theme-name">{theme}</h2>
            <div class="hub-topic-grid">
              {reviewableTopics.map((topic) => (
                <div class="hub-topic-card" data-slug={topic.slug}>
                  <div class="hub-topic-title-row">
                    <a href={`/topics/${topic.slug}`} class="hub-topic-title">{topic.title}</a>
                  </div>
                  <div class="hub-topic-actions">
                    {topic.hasFlashcards && (
                      <a href={`/micro/review/${topic.slug}`} class="hub-action hub-action-flashcards">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                          <rect x="1" y="3" width="10" height="8" rx="1.5" />
                          <rect x="3" y="1" width="10" height="8" rx="1.5" />
                        </svg>
                        {topic.cardCount} cards
                        <span class="hub-status-dot" data-fc-status={topic.slug}></span>
                      </a>
                    )}
                    {topic.hasQuiz && (
                      <a href={`/micro/quiz/${topic.slug}`} class="hub-action hub-action-quiz">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                          <circle cx="7" cy="7" r="5.5" />
                          <path d="M5.5 5.5a1.5 1.5 0 012.7.5c0 1-1.5 1.5-1.5 1.5" />
                          <circle cx="7" cy="10" r="0.3" fill="currentColor" />
                        </svg>
                        Quiz
                        <span class="hub-status-dot" data-quiz-status={topic.slug}></span>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .hub-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .hub-header {
    margin-bottom: 2.5rem;
  }

  .hub-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin: 0 0 0.5rem;
  }

  .hub-desc {
    font-size: 1rem;
    color: var(--color-text-medium);
    margin: 0;
    line-height: 1.6;
  }

  .hub-theme-section {
    margin-bottom: 2.5rem;
  }

  .hub-theme-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-racing-green);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-pale-mint-dark);
  }

  .hub-topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .hub-topic-card {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-pale-mint-dark);
    border-radius: 0.75rem;
    background-color: var(--color-white);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-topic-card:hover {
    border-color: var(--color-racing-green-light);
    box-shadow: 0 2px 8px rgba(6, 54, 34, 0.06);
  }

  .hub-topic-title-row {
    margin-bottom: 0.75rem;
  }

  .hub-topic-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-racing-green);
    text-decoration: none;
    line-height: 1.3;
  }

  .hub-topic-title:hover {
    color: var(--color-racing-green-light);
  }

  .hub-topic-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hub-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s ease;
  }

  .hub-action-flashcards {
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
  }

  .hub-action-flashcards:hover {
    background-color: var(--color-pale-mint-dark);
  }

  .hub-action-quiz {
    color: var(--color-peach-dark);
    background-color: var(--color-peach-light, #fff4e6);
  }

  .hub-action-quiz:hover {
    background-color: var(--color-peach);
  }

  .hub-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: none;
    flex-shrink: 0;
  }

  .hub-status-dot.completed {
    display: inline-block;
    background-color: var(--color-racing-green);
  }

  .hub-status-dot.attempted {
    display: inline-block;
    background-color: var(--color-peach-dark);
  }

  /* Dark mode */
  html[data-theme="dark"] {
    .hub-title {
      color: var(--color-night-text);
    }

    .hub-desc {
      color: var(--color-night-text-muted);
    }

    .hub-theme-name {
      color: var(--color-night-text);
      border-bottom-color: var(--color-night-elevated);
    }

    .hub-topic-card {
      background-color: var(--color-night-surface);
      border-color: var(--color-night-elevated);
    }

    .hub-topic-card:hover {
      border-color: var(--color-night-accent);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .hub-topic-title {
      color: var(--color-night-text);
    }

    .hub-topic-title:hover {
      color: var(--color-night-accent);
    }

    .hub-action-flashcards {
      color: var(--color-night-text);
      background-color: var(--color-night-elevated);
    }

    .hub-action-flashcards:hover {
      background-color: var(--color-night-surface);
    }

    .hub-action-quiz {
      color: var(--color-night-accent);
      background-color: rgba(255, 183, 77, 0.12);
    }

    .hub-action-quiz:hover {
      background-color: rgba(255, 183, 77, 0.2);
    }

    .hub-status-dot.completed {
      background-color: var(--color-night-accent);
    }
  }
</style>

<script>
  // Hydrate progress indicators from localStorage
  try {
    const raw = localStorage.getItem('fa-progress');
    if (raw) {
      const state = JSON.parse(raw);
      if (state.version === 1) {
        // Flashcard review status
        if (state.flashcardsReviewed) {
          for (const [slug, result] of Object.entries(state.flashcardsReviewed)) {
            const dot = document.querySelector(`[data-fc-status="${slug}"]`) as HTMLElement;
            if (dot) {
              dot.classList.add('completed');
            }
          }
        }

        // Quiz status
        if (state.quizResults) {
          for (const [slug, result] of Object.entries(state.quizResults)) {
            const dot = document.querySelector(`[data-quiz-status="${slug}"]`) as HTMLElement;
            if (dot) {
              dot.classList.add((result as any).passed ? 'completed' : 'attempted');
            }
          }
        }
      }
    }
  } catch {}
</script>
