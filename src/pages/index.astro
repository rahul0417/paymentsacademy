---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TopicCard from '../components/TopicCard.astro';
import { themes, getTopicsByTheme } from '../data/themes';

const { topicsByTheme } = await getTopicsByTheme();
---

<BaseLayout
  title="PaymentsAcademy"
  description="A free, open knowledge base that explains the payments ecosystem — from card swipes to cross-border settlements — in plain language."
>
  <Hero />

  <!-- Topics Grid Section -->
  <section id="topics" class="topics-section">
    <div class="topics-container">
      <div class="topics-header">
        <h2 class="topics-heading">Topics</h2>
        <p class="topics-intro">
          Explore the payments ecosystem, one concept at a time. Each topic is a
          self-contained guide written in plain language.
        </p>
      </div>

      {themes.map((theme, themeIndex) => {
        const publishedTopics = topicsByTheme.get(theme.name) || [];

        return (
          <div
            class="theme-group"
            style={`animation-delay: ${0.1 + themeIndex * 0.08}s;`}
          >
            <div class="theme-header">
              <h3 class="theme-name">{theme.name}</h3>
              <p class="theme-description">{theme.description}</p>
            </div>

            <div class="topic-grid">
              {publishedTopics.map((topic) => (
                <TopicCard
                  title={topic.data.title}
                  description={topic.data.description}
                  theme={topic.data.theme}
                  readingTime={topic.data.readingTime}
                  href={`/topics/${topic.id}`}
                />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  /* Topics Section */
  .topics-section {
    padding: 2rem 1.5rem 5rem;
  }

  .topics-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .topics-header {
    text-align: center;
    margin-bottom: 3.5rem;
    animation: fadeInUp 0.6s ease both;
  }

  .topics-heading {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .topics-intro {
    font-size: 1.05rem;
    color: var(--color-text-medium);
    max-width: 32rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Theme Groups */
  .theme-group {
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s ease both;
  }

  .theme-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-pale-mint-dark);
  }

  .theme-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin-bottom: 0.25rem;
  }

  .theme-description {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  /* Topic Grid */
  .topic-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .topic-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Dark mode */
  html[data-theme="dark"] {
    .topics-heading {
      color: var(--color-night-text);
    }

    .topics-intro {
      color: var(--color-night-text-muted);
    }

    .theme-name {
      color: var(--color-night-text);
    }

    .theme-description {
      color: var(--color-night-text-muted);
    }

    .theme-header {
      border-bottom-color: var(--color-night-elevated);
    }
  }

  /* Responsive */
  @media (min-width: 768px) {
    .topics-section {
      padding: 3rem 2rem 6rem;
    }
  }
</style>
