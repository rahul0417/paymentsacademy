---
interface Props {
  topicSlug: string;
  topicTitle: string;
  theme: string;
  keyTakeaways: string[];
  cards: { id: string; front: string; back: string }[];
}

const { topicSlug, topicTitle, theme, keyTakeaways, cards } = Astro.props;

const cardData = JSON.stringify({ topicSlug, keyTakeaways, cards });
---

<div class="flashcard-viewer" data-cards={cardData}>
  <!-- Key Takeaways (first screen) -->
  <div class="fc-screen fc-takeaways active">
    <div class="fc-progress-label">
      <span class="fc-step">Key Takeaways</span>
      <span class="fc-count">{cards.length} cards to review</span>
    </div>
    <div class="fc-takeaways-card">
      <h3 class="fc-takeaways-title">{topicTitle}</h3>
      <ul class="fc-takeaways-list">
        {keyTakeaways.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <button class="fc-btn fc-btn-primary fc-start-btn">
      Start Review
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4l4 4-4 4" /></svg>
    </button>
  </div>

  <!-- Flashcard screen -->
  <div class="fc-screen fc-cards">
    <div class="fc-progress-label">
      <span class="fc-step">Card <span class="fc-current-num">1</span> of {cards.length}</span>
      <div class="fc-dots">
        {cards.map((_, i) => <span class="fc-dot" data-dot={i} />)}
      </div>
    </div>

    <div class="fc-card-container">
      <div class="fc-card" role="button" tabindex="0" aria-label="Click to flip card">
        <div class="fc-card-inner">
          <div class="fc-card-front">
            <span class="fc-card-hint">Tap to reveal answer</span>
            <p class="fc-card-question"></p>
          </div>
          <div class="fc-card-back">
            <div class="fc-card-answer prose"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="fc-actions" style="display: none;">
      <button class="fc-btn fc-btn-outline fc-review-btn">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8a6 6 0 0111.5-2.3M14 3v3h-3" /><path d="M14 8a6 6 0 01-11.5 2.3M2 13v-3h3" /></svg>
        Review again
      </button>
      <button class="fc-btn fc-btn-primary fc-gotit-btn">
        Got it
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-6" /></svg>
      </button>
    </div>
  </div>

  <!-- Completion screen -->
  <div class="fc-screen fc-complete">
    <div class="fc-complete-icon">&#10003;</div>
    <p class="fc-complete-title">Review Complete!</p>
    <p class="fc-complete-score"></p>
    <div class="fc-complete-actions">
      <button class="fc-btn fc-btn-outline fc-restart-btn">Restart Deck</button>
      <a href={`/topics/${topicSlug}`} class="fc-btn fc-btn-primary">Back to Article</a>
    </div>
  </div>
</div>

<style>
  .flashcard-viewer {
    max-width: 42rem;
    margin: 0 auto;
  }

  .fc-screen {
    display: none;
  }

  .fc-screen.active {
    display: block;
  }

  .fc-progress-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .fc-step {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-light);
  }

  .fc-count {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .fc-dots {
    display: flex;
    gap: 0.3rem;
  }

  .fc-dot {
    width: 1.5rem;
    height: 4px;
    border-radius: 2px;
    background-color: var(--color-pale-mint-dark);
    transition: background-color 0.2s ease;
  }

  .fc-dot.active {
    background-color: var(--color-racing-green);
  }

  .fc-dot.done {
    background-color: var(--color-racing-green-light);
  }

  .fc-dot.review {
    background-color: var(--color-peach);
  }

  /* Takeaways card */
  .fc-takeaways-card {
    background-color: var(--color-pale-mint);
    border-left: 3px solid var(--color-peach);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.5rem;
  }

  .fc-takeaways-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin: 0 0 1rem;
  }

  .fc-takeaways-list {
    margin: 0;
    padding: 0 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fc-takeaways-list li {
    font-size: 0.95rem;
    color: var(--color-text-medium);
    line-height: 1.55;
  }

  /* Flashcard */
  .fc-card-container {
    perspective: 1000px;
    margin-bottom: 1.5rem;
  }

  .fc-card {
    cursor: pointer;
    min-height: 16rem;
    position: relative;
  }

  .fc-card-inner {
    position: relative;
    width: 100%;
    min-height: 16rem;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .fc-card.flipped .fc-card-inner {
    transform: rotateY(180deg);
  }

  .fc-card-front,
  .fc-card-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 16rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 0.75rem;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .fc-card-front {
    background-color: var(--color-white);
    border: 1.5px solid var(--color-pale-mint-dark);
    box-shadow: 0 2px 12px rgba(6, 54, 34, 0.06);
  }

  .fc-card-back {
    background-color: var(--color-pale-mint);
    border: 1.5px solid var(--color-racing-green-light);
    transform: rotateY(180deg);
  }

  .fc-card-hint {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .fc-card-question {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-racing-green);
    line-height: 1.45;
    margin: 0;
  }

  .fc-card-answer {
    font-size: 0.95rem;
    color: var(--color-text-medium);
    line-height: 1.65;
  }

  /* Buttons */
  .fc-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .fc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.5rem;
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
    border: 1.5px solid transparent;
  }

  .fc-btn-primary {
    background-color: var(--color-racing-green);
    color: var(--color-white);
    border-color: var(--color-racing-green);
  }

  .fc-btn-primary:hover {
    background-color: var(--color-racing-green-light);
    border-color: var(--color-racing-green-light);
  }

  .fc-btn-outline {
    background-color: transparent;
    color: var(--color-racing-green);
    border-color: var(--color-racing-green);
  }

  .fc-btn-outline:hover {
    background-color: var(--color-racing-green);
    color: var(--color-white);
  }

  /* Completion */
  .fc-complete {
    text-align: center;
    padding: 3rem 1rem;
  }

  .fc-complete-icon {
    font-size: 3rem;
    color: var(--color-racing-green);
    margin-bottom: 0.5rem;
  }

  .fc-complete-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin: 0 0 0.5rem;
  }

  .fc-complete-score {
    font-size: 0.95rem;
    color: var(--color-text-medium);
    margin: 0 0 1.5rem;
  }

  .fc-complete-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Dark mode */
  html[data-theme="dark"] {
    .fc-step,
    .fc-count {
      color: var(--color-night-text-muted);
    }

    .fc-dot {
      background-color: var(--color-night-elevated);
    }

    .fc-dot.active {
      background-color: var(--color-night-accent);
    }

    .fc-dot.done {
      background-color: rgba(255, 218, 179, 0.5);
    }

    .fc-dot.review {
      background-color: var(--color-night-accent);
    }

    .fc-takeaways-card {
      background-color: var(--color-night-surface);
      border-left-color: var(--color-night-accent);
    }

    .fc-takeaways-title {
      color: var(--color-night-text);
    }

    .fc-takeaways-list li {
      color: var(--color-night-text-muted);
    }

    .fc-card-front {
      background-color: var(--color-night-surface);
      border-color: var(--color-night-elevated);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
    }

    .fc-card-back {
      background-color: var(--color-night-elevated);
      border-color: var(--color-night-accent);
    }

    .fc-card-hint {
      color: var(--color-night-text-muted);
    }

    .fc-card-question {
      color: var(--color-night-text);
    }

    .fc-card-answer {
      color: var(--color-night-text-muted);
    }

    .fc-btn-primary {
      background-color: var(--color-night-elevated);
      color: var(--color-night-text);
      border-color: var(--color-night-elevated);
    }

    .fc-btn-primary:hover {
      background-color: var(--color-night-accent);
      border-color: var(--color-night-accent);
      color: var(--color-night);
    }

    .fc-btn-outline {
      color: var(--color-night-accent);
      border-color: var(--color-night-accent);
    }

    .fc-btn-outline:hover {
      background-color: var(--color-night-elevated);
      color: var(--color-night-text);
    }

    .fc-complete-icon {
      color: var(--color-night-accent);
    }

    .fc-complete-title {
      color: var(--color-night-text);
    }

    .fc-complete-score {
      color: var(--color-night-text-muted);
    }
  }

  @media (max-width: 640px) {
    .fc-card-front,
    .fc-card-back {
      padding: 1.5rem 1.25rem;
      min-height: 14rem;
    }

    .fc-card-inner {
      min-height: 14rem;
    }

    .fc-card-question {
      font-size: 1.1rem;
    }

    .fc-actions {
      flex-direction: column;
    }

    .fc-btn {
      justify-content: center;
    }
  }
</style>

<script>
  document.querySelectorAll('.flashcard-viewer').forEach((viewer) => {
    const el = viewer as HTMLElement;
    const data = JSON.parse(el.dataset.cards || '{}');
    const cards: { id: string; front: string; back: string }[] = data.cards || [];
    const topicSlug: string = data.topicSlug || '';
    if (cards.length === 0) return;

    const takeawaysScreen = el.querySelector('.fc-takeaways') as HTMLElement;
    const cardsScreen = el.querySelector('.fc-cards') as HTMLElement;
    const completeScreen = el.querySelector('.fc-complete') as HTMLElement;
    const startBtn = el.querySelector('.fc-start-btn') as HTMLButtonElement;
    const card = el.querySelector('.fc-card') as HTMLElement;
    const questionEl = el.querySelector('.fc-card-question') as HTMLElement;
    const answerEl = el.querySelector('.fc-card-answer') as HTMLElement;
    const actionsEl = el.querySelector('.fc-actions') as HTMLElement;
    const gotItBtn = el.querySelector('.fc-gotit-btn') as HTMLButtonElement;
    const reviewBtn = el.querySelector('.fc-review-btn') as HTMLButtonElement;
    const currentNumEl = el.querySelector('.fc-current-num') as HTMLElement;
    const dots = el.querySelectorAll('.fc-dot');
    const restartBtn = el.querySelector('.fc-restart-btn') as HTMLButtonElement;
    const scoreEl = el.querySelector('.fc-complete-score') as HTMLElement;

    // Deck state
    let deck = [...cards.map((c, i) => ({ ...c, originalIndex: i }))];
    let currentIndex = 0;
    let gotItCount = 0;
    let totalCards = cards.length;

    function showScreen(screen: HTMLElement) {
      [takeawaysScreen, cardsScreen, completeScreen].forEach((s) => s.classList.remove('active'));
      screen.classList.add('active');
    }

    function renderCard() {
      const c = deck[currentIndex];
      card.classList.remove('flipped');
      actionsEl.style.display = 'none';
      questionEl.textContent = c.front;
      answerEl.innerHTML = c.back;
      currentNumEl.textContent = String(currentIndex + 1);

      // Update dots
      dots.forEach((dot) => {
        dot.classList.remove('active', 'done', 'review');
      });
      // Mark completed cards
      for (let i = 0; i < deck.length; i++) {
        const dot = dots[deck[i].originalIndex];
        if (dot) {
          if (i < currentIndex) {
            dot.classList.add('done');
          } else if (i === currentIndex) {
            dot.classList.add('active');
          }
        }
      }
      // Cards removed from deck (got it) — mark as done
      const deckOriginals = new Set(deck.map((d) => d.originalIndex));
      dots.forEach((dot, i) => {
        if (!deckOriginals.has(i)) {
          dot.classList.add('done');
        }
      });
    }

    function flipCard() {
      if (!card.classList.contains('flipped')) {
        card.classList.add('flipped');
        actionsEl.style.display = 'flex';
      }
    }

    function advance() {
      if (deck.length === 0) {
        showComplete();
        return;
      }
      if (currentIndex >= deck.length) {
        currentIndex = 0;
      }
      renderCard();
    }

    function showComplete() {
      showScreen(completeScreen);
      scoreEl.textContent = `You got ${gotItCount} of ${totalCards} cards on first try.`;

      // Save to localStorage
      try {
        const STORAGE_KEY = 'fa-progress';
        const raw = localStorage.getItem(STORAGE_KEY);
        const state = raw ? JSON.parse(raw) : { version: 1, topicsRead: {}, quizResults: {}, microLessonsCompleted: {}, flashcardsReviewed: {}, streak: { currentStreak: 0, longestStreak: 0, lastVisitDate: '' } };
        if (!state.flashcardsReviewed) state.flashcardsReviewed = {};
        state.flashcardsReviewed[topicSlug] = {
          completedAt: Date.now(),
          cardsTotal: totalCards,
          cardsGotIt: gotItCount,
        };
        // Update streak
        const today = new Date();
        const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
        const yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);
        const yesterdayStr = `${yesterday.getFullYear()}-${String(yesterday.getMonth() + 1).padStart(2, '0')}-${String(yesterday.getDate()).padStart(2, '0')}`;
        if (state.streak.lastVisitDate !== todayStr) {
          state.streak.currentStreak = state.streak.lastVisitDate === yesterdayStr ? state.streak.currentStreak + 1 : 1;
          if (state.streak.currentStreak > state.streak.longestStreak) state.streak.longestStreak = state.streak.currentStreak;
          state.streak.lastVisitDate = todayStr;
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {}
    }

    // Event listeners
    startBtn.addEventListener('click', () => {
      showScreen(cardsScreen);
      renderCard();
    });

    card.addEventListener('click', flipCard);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        flipCard();
      }
    });

    gotItBtn.addEventListener('click', () => {
      gotItCount++;
      deck.splice(currentIndex, 1);
      if (currentIndex >= deck.length) currentIndex = 0;
      advance();
    });

    reviewBtn.addEventListener('click', () => {
      // Move current card to end of deck
      const current = deck.splice(currentIndex, 1)[0];
      deck.push(current);
      if (currentIndex >= deck.length) currentIndex = 0;
      advance();
    });

    restartBtn.addEventListener('click', () => {
      deck = [...cards.map((c, i) => ({ ...c, originalIndex: i }))];
      currentIndex = 0;
      gotItCount = 0;
      showScreen(cardsScreen);
      renderCard();
    });
  });
</script>
