---
import { themeNames, getTopicsByTheme } from '../data/themes';
import { getAllQuizSlugs } from '../data/quizzes';
import { getAllFlashcardSlugs } from '../data/flashcards';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const { topicsByTheme } = await getTopicsByTheme();
const quizSlugs = getAllQuizSlugs();
const flashcardSlugs = getAllFlashcardSlugs();

const groupedTopics = themeNames
  .map((theme) => ({ theme, topics: topicsByTheme.get(theme) || [] }))
  .filter((group) => group.topics.length > 0);
---

<aside class="sidebar" id="topic-sidebar">
  <nav class="sidebar-nav" aria-label="Topic navigation">
    <div class="sidebar-header">
      <h2 class="sidebar-title">Topics</h2>
    </div>

    {groupedTopics.map(({ theme, topics }) => {
      const isCurrentTheme = topics.some((t) => t.id === currentSlug);
      return (
        <details class="sidebar-group" open={isCurrentTheme}>
          <summary class="sidebar-group-label">
            <svg class="sidebar-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 2.5l3.5 3.5-3.5 3.5" />
            </svg>
            {theme}
          </summary>
          <ul class="sidebar-topic-list">
            {topics.map((topic) => {
              const isActive = topic.id === currentSlug;
              const hasQuiz = quizSlugs.includes(topic.id);
              const hasFlashcards = flashcardSlugs.includes(topic.id);
              return (
                <li>
                  <div class="sidebar-link-row">
                    <a
                      href={`/topics/${topic.id}`}
                      class:list={['sidebar-link', { active: isActive }]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {topic.data.title}
                    </a>
                    <div class="sidebar-link-icons">
                      {hasQuiz && (
                        <a href={`/micro/quiz/${topic.id}`} class="sidebar-icon-link" title="Take quiz" aria-label={`Quiz: ${topic.data.title}`}>
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                            <circle cx="6" cy="6" r="4.5" />
                            <path d="M5 5a1.2 1.2 0 012.2.5c0 .8-1.2 1.2-1.2 1.2" />
                            <circle cx="6" cy="8.5" r="0.3" fill="currentColor" />
                          </svg>
                        </a>
                      )}
                      {hasFlashcards && (
                        <a href={`/micro/review/${topic.id}`} class="sidebar-icon-link" title="Quick review" aria-label={`Review: ${topic.data.title}`}>
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                            <rect x="1" y="3" width="8" height="6" rx="1" />
                            <rect x="3" y="1" width="8" height="6" rx="1" />
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </nav>
</aside>

<style>
  .sidebar {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding-right: 1.5rem;
    padding-bottom: 2rem;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sidebar-header {
    margin-bottom: 0.75rem;
  }

  .sidebar-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin: 0;
  }

  .sidebar-group {
    border: none;
    margin-bottom: 0.25rem;
  }

  .sidebar-group[open] .sidebar-chevron {
    transform: rotate(90deg);
  }

  .sidebar-group-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-racing-green);
    cursor: pointer;
    padding: 0.4rem 0;
    list-style: none;
    user-select: none;
  }

  .sidebar-group-label::-webkit-details-marker {
    display: none;
  }

  .sidebar-group-label::marker {
    display: none;
    content: '';
  }

  .sidebar-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--color-text-light);
  }

  .sidebar-topic-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem 0;
  }

  .sidebar-link {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-medium);
    text-decoration: none;
    padding: 0.3rem 0.75rem;
    margin-left: 0.25rem;
    border-left: 2px solid transparent;
    border-radius: 0 0.25rem 0.25rem 0;
    transition: all 0.15s ease;
  }

  .sidebar-link:hover {
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
    border-left-color: var(--color-pale-mint-dark);
  }

  .sidebar-link.active {
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
    border-left-color: var(--color-racing-green);
    font-weight: 500;
  }

  .sidebar-link-row {
    display: flex;
    align-items: center;
  }

  .sidebar-link-icons {
    display: flex;
    gap: 0.15rem;
    margin-left: auto;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .sidebar-link-row:hover .sidebar-link-icons {
    opacity: 1;
  }

  .sidebar-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 0.25rem;
    color: var(--color-text-light);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .sidebar-icon-link:hover {
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
  }

  @media (max-width: 1023px) {
    .sidebar {
      display: none;
    }
  }

  html[data-theme="dark"] {
    .sidebar-title {
      color: var(--color-night-text-muted);
    }

    .sidebar-group-label {
      color: var(--color-night-text);
    }

    .sidebar-chevron {
      color: var(--color-night-text-muted);
    }

    .sidebar-link {
      color: var(--color-night-text-muted);
    }

    .sidebar-link:hover {
      color: var(--color-night-text);
      background-color: var(--color-night-surface);
      border-left-color: var(--color-night-elevated);
    }

    .sidebar-link.active {
      color: var(--color-night-accent);
      background-color: var(--color-night-surface);
      border-left-color: var(--color-night-accent);
    }

    .sidebar-icon-link {
      color: var(--color-night-text-muted);
    }

    .sidebar-icon-link:hover {
      color: var(--color-night-accent);
      background-color: var(--color-night-surface);
    }
  }
</style>
