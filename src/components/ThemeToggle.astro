---
// ThemeToggle.astro — cycles through light / dark / system
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="icon icon-system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="20" height="14" rx="2" />
    <line x1="8" y1="21" x2="16" y2="21" />
    <line x1="12" y1="17" x2="12" y2="21" />
  </svg>
</button>

<script>
  const STORAGE_KEY = 'theme-preference';
  const MODES = ['light', 'dark', 'system'] as const;

  function getStoredTheme(): string {
    try { return localStorage.getItem(STORAGE_KEY) || 'system'; } catch { return 'system'; }
  }

  function getSystemTheme(): string {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(preference: string) {
    const resolved = preference === 'system' ? getSystemTheme() : preference;
    document.documentElement.setAttribute('data-theme', resolved);
    document.documentElement.setAttribute('data-theme-preference', preference);
    try { localStorage.setItem(STORAGE_KEY, preference); } catch {}
    updateButtonState(preference);
  }

  function updateButtonState(preference: string) {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.classList.remove('mode-light', 'mode-dark', 'mode-system');
    btn.classList.add(`mode-${preference}`);

    const labels: Record<string, string> = {
      light: 'Switch to dark mode',
      dark: 'Switch to system mode',
      system: 'Switch to light mode',
    };
    btn.setAttribute('aria-label', labels[preference] || 'Toggle theme');
    btn.setAttribute('title', labels[preference] || 'Toggle theme');
  }

  function cycleTheme() {
    const current = getStoredTheme();
    const idx = MODES.indexOf(current as typeof MODES[number]);
    const next = MODES[(idx + 1) % MODES.length];
    applyTheme(next);
  }

  // Initialize
  const preference = getStoredTheme();
  updateButtonState(preference);

  document.getElementById('theme-toggle')?.addEventListener('click', cycleTheme);

  // Re-apply when system preference changes (relevant in system mode)
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getStoredTheme() === 'system') {
      applyTheme('system');
    }
  });
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-pale-mint-dark);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--color-text-light);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-racing-green-light);
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
  }

  /* Icon visibility: hide all by default, show based on mode */
  .icon {
    display: none;
  }

  /* In light mode, show moon (click to go dark) */
  .theme-toggle.mode-light .icon-moon {
    display: block;
  }

  /* In dark mode, show sun (click to go system) */
  .theme-toggle.mode-dark .icon-sun {
    display: block;
  }

  /* In system mode, show system icon (click to go light) */
  .theme-toggle.mode-system .icon-system {
    display: block;
  }

  /* Fallback: if no mode class yet, show system icon */
  .theme-toggle:not(.mode-light):not(.mode-dark):not(.mode-system) .icon-system {
    display: block;
  }

  /* Dark mode styles */
  html[data-theme="dark"] .theme-toggle {
    border-color: var(--color-night-elevated);
    color: var(--color-night-text-muted);
  }

  html[data-theme="dark"] .theme-toggle:hover {
    border-color: var(--color-night-accent);
    color: var(--color-night-text);
    background-color: var(--color-night-surface);
  }
</style>
