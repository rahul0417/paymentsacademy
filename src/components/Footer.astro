---
const currentYear = new Date().getFullYear();

const sections = [
  {
    title: 'Learn',
    links: [
      { label: 'Topics', href: '/topics' },
      { label: 'Glossary', href: '/glossary' },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'About FintechAcademy', href: '/about' },
      { label: 'Contributing', href: '/contributing' },
    ],
  },
];
---

<footer class="footer-wrapper mt-auto">
  <div class="footer-separator" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-6 py-16">
    <!-- Tagline -->
    <div class="mb-12">
      <p class="font-heading text-lg md:text-xl font-medium leading-relaxed max-w-md" style="color: var(--color-racing-green);">
        Built to help you understand<br />how money moves.
      </p>
    </div>

    <!-- Links grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 mb-12">
      {sections.map(({ title, links }) => (
        <div>
          <h4 class="footer-heading">{title}</h4>
          <ul class="list-none m-0 p-0 flex flex-col gap-2">
            {links.map(({ label, href }) => (
              <li>
                <a href={href} class="footer-link">{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Home link column -->
      <div>
        <h4 class="footer-heading">Site</h4>
        <ul class="list-none m-0 p-0 flex flex-col gap-2">
          <li><a href="/" class="footer-link">Home</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-8 border-t" style="border-color: var(--color-pale-mint-dark);">
      <div class="flex items-center gap-2">
        <span class="font-heading text-sm font-semibold tracking-tight" style="color: var(--color-racing-green);">
          Fintech<span style="color: var(--color-peach-dark);">Academy</span>
        </span>
      </div>
      <p class="text-xs" style="color: var(--color-text-light);">
        &copy; {currentYear} FintechAcademy. Open knowledge for the curious.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background-color: var(--color-pale-mint);
  }

  .footer-separator {
    max-width: 72rem;
    margin: 0 auto;
    border-top: 1px solid var(--color-pale-mint-dark);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: var(--color-racing-green);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-peach-dark);
  }

  html[data-theme="dark"] {
    .footer-wrapper {
      background-color: var(--color-night-surface);
    }

    .footer-separator {
      border-top-color: var(--color-night-elevated);
    }

    .footer-heading {
      color: var(--color-night-text-muted);
    }

    .footer-link {
      color: var(--color-night-text-muted);
    }

    .footer-link:hover {
      color: var(--color-night-accent);
    }
  }
</style>
