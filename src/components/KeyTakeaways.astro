---
import { getFlashcardsBySlug } from '../data/flashcards';

interface Props {
  topicSlug: string;
}

const { topicSlug } = Astro.props;
const flashcardData = getFlashcardsBySlug(topicSlug);
const takeaways = flashcardData?.keyTakeaways ?? [];
---

{takeaways.length > 0 && (
  <details class="key-takeaways">
    <summary class="key-takeaways-toggle">
      <svg class="key-takeaways-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 3.5l4 4-4 4" />
      </svg>
      <span class="key-takeaways-label">Key Takeaways</span>
    </summary>
    <ul class="key-takeaways-list">
      {takeaways.map((t) => <li>{t}</li>)}
    </ul>
  </details>
)}

<style>
  .key-takeaways {
    background-color: var(--color-pale-mint);
    border-left: 3px solid var(--color-peach);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.85rem 1.25rem;
    margin-top: 1rem;
  }

  .key-takeaways-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .key-takeaways-toggle::-webkit-details-marker {
    display: none;
  }

  .key-takeaways-toggle::marker {
    display: none;
    content: '';
  }

  .key-takeaways-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--color-peach-dark);
  }

  .key-takeaways[open] .key-takeaways-chevron {
    transform: rotate(90deg);
  }

  .key-takeaways-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-peach-dark);
  }

  .key-takeaways-list {
    margin: 0.75rem 0 0;
    padding: 0 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .key-takeaways-list li {
    font-size: 0.9rem;
    color: var(--color-text-medium);
    line-height: 1.55;
  }

  html[data-theme="dark"] {
    .key-takeaways {
      background-color: var(--color-night-surface);
      border-left-color: var(--color-night-accent);
    }

    .key-takeaways-chevron {
      color: var(--color-night-accent);
    }

    .key-takeaways-label {
      color: var(--color-night-accent);
    }

    .key-takeaways-list li {
      color: var(--color-night-text-muted);
    }
  }
</style>
