---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { themes, getTopicsByTheme } from '../../data/themes';
import { getAllQuizSlugs } from '../../data/quizzes';
import { getAllMicroLessonSlugs, getMicroLessonBySlug } from '../../data/microlearning';

const { topicsByTheme } = await getTopicsByTheme();
const quizSlugs = getAllQuizSlugs();
const microLessonSlugs = getAllMicroLessonSlugs();

const groupedTopics = themes
  .map((theme) => {
    const topics = topicsByTheme.get(theme.name) || [];
    return {
      theme: theme.name,
      topics: topics.map((t) => {
        const ml = getMicroLessonBySlug(t.id);
        return {
          slug: t.id,
          title: t.data.title,
          hasQuiz: quizSlugs.includes(t.id),
          hasMicroLesson: microLessonSlugs.includes(t.id),
          slideCount: ml?.slides.length ?? 0,
        };
      }),
    };
  })
  .filter((g) => g.topics.some((t) => t.hasMicroLesson || t.hasQuiz));

const topicData = JSON.stringify(groupedTopics.flatMap((g) =>
  g.topics.filter((t) => t.hasMicroLesson || t.hasQuiz).map((t) => ({
    slug: t.slug,
    hasMicroLesson: t.hasMicroLesson,
    hasQuiz: t.hasQuiz,
  }))
));
---

<BaseLayout title="Micro Learning" description="Learn and review concepts through structured slide decks and quizzes.">
  <div class="hub-page">
    <header class="hub-header">
      <h1 class="hub-title">Micro Learning</h1>
      <p class="hub-desc">Learn and review concepts through structured slide decks and quizzes.</p>
    </header>

    <div class="hub-themes" data-topics={topicData}>
      {groupedTopics.map(({ theme, topics }) => {
        const reviewableTopics = topics.filter((t) => t.hasMicroLesson || t.hasQuiz);
        if (reviewableTopics.length === 0) return null;

        return (
          <section class="hub-theme-section">
            <h2 class="hub-theme-name">{theme}</h2>
            <div class="hub-topic-grid">
              {reviewableTopics.map((topic) => (
                <div class="hub-topic-card" data-slug={topic.slug}>
                  <div class="hub-topic-title-row">
                    <a href={topic.hasMicroLesson ? `/micro/review/${topic.slug}` : `/micro/quiz/${topic.slug}`} class="hub-topic-title">{topic.title}</a>
                  </div>
                  <div class="hub-topic-actions">
                    {topic.hasMicroLesson && (
                      <a href={`/micro/review/${topic.slug}`} class="hub-action hub-action-flashcards">
                        Enter
                        <span class="hub-status-dot" data-ml-status={topic.slug}></span>
                      </a>
                    )}
                    {!topic.hasMicroLesson && topic.hasQuiz && (
                      <a href={`/micro/quiz/${topic.slug}`} class="hub-action hub-action-quiz">
                        Quiz
                        <span class="hub-status-dot" data-quiz-status={topic.slug}></span>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .hub-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .hub-header {
    margin-bottom: 2.5rem;
  }

  .hub-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin: 0 0 0.5rem;
  }

  .hub-desc {
    font-size: 1rem;
    color: var(--color-text-medium);
    margin: 0;
    line-height: 1.6;
  }

  .hub-theme-section {
    margin-bottom: 2.5rem;
  }

  .hub-theme-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-racing-green);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-pale-mint-dark);
  }

  .hub-topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .hub-topic-card {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-pale-mint-dark);
    border-radius: 0.75rem;
    background-color: var(--color-white);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-topic-card:hover {
    border-color: var(--color-racing-green-light);
    box-shadow: 0 2px 8px rgba(6, 54, 34, 0.06);
  }

  .hub-topic-title-row {
    margin-bottom: 0.75rem;
  }

  .hub-topic-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-racing-green);
    text-decoration: none;
    line-height: 1.3;
  }

  .hub-topic-title:hover {
    color: var(--color-racing-green-light);
  }

  .hub-topic-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hub-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s ease;
  }

  .hub-action-flashcards {
    color: var(--color-racing-green);
    background-color: var(--color-pale-mint);
  }

  .hub-action-flashcards:hover {
    background-color: var(--color-pale-mint-dark);
  }

  .hub-action-quiz {
    color: var(--color-peach-dark);
    background-color: var(--color-peach-light, #fff4e6);
  }

  .hub-action-quiz:hover {
    background-color: var(--color-peach);
  }

  .hub-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: none;
    flex-shrink: 0;
  }

  .hub-status-dot.completed {
    display: inline-block;
    background-color: var(--color-racing-green);
  }

  .hub-status-dot.attempted {
    display: inline-block;
    background-color: var(--color-peach-dark);
  }

  /* Dark mode */
  html[data-theme="dark"] {
    .hub-title {
      color: var(--color-night-text);
    }

    .hub-desc {
      color: var(--color-night-text-muted);
    }

    .hub-theme-name {
      color: var(--color-night-text);
      border-bottom-color: var(--color-night-elevated);
    }

    .hub-topic-card {
      background-color: var(--color-night-surface);
      border-color: var(--color-night-elevated);
    }

    .hub-topic-card:hover {
      border-color: var(--color-night-accent);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .hub-topic-title {
      color: var(--color-night-text);
    }

    .hub-topic-title:hover {
      color: var(--color-night-accent);
    }

    .hub-action-flashcards {
      color: var(--color-night-text);
      background-color: var(--color-night-elevated);
    }

    .hub-action-flashcards:hover {
      background-color: var(--color-night-surface);
    }

    .hub-action-quiz {
      color: var(--color-night-accent);
      background-color: rgba(255, 183, 77, 0.12);
    }

    .hub-action-quiz:hover {
      background-color: rgba(255, 183, 77, 0.2);
    }

    .hub-status-dot.completed {
      background-color: var(--color-night-accent);
    }
  }
</style>

<script>
  import { loadProgress } from '../../data/progress';

  // Hydrate progress indicators from localStorage
  try {
    const state = loadProgress();

    for (const slug of Object.keys(state.microLearningCompleted)) {
      const dot = document.querySelector(`[data-ml-status="${slug}"]`) as HTMLElement;
      if (dot) {
        dot.classList.add('completed');
      }
    }

    for (const [slug, result] of Object.entries(state.quizResults)) {
      const dot = document.querySelector(`[data-quiz-status="${slug}"]`) as HTMLElement;
      if (dot) {
        dot.classList.add(result.passed ? 'completed' : 'attempted');
      }
    }
  } catch {}
</script>
