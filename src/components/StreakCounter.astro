---
// StreakCounter: displays flame icon + streak count in the header
// Rendered hidden, populated client-side from localStorage
---

<span class="streak-counter" id="streak-counter" style="display: none;" title="Learning streak">
  <svg class="streak-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 1C8 1 3 6 3 9.5a5 5 0 0010 0C13 6 8 1 8 1z" />
    <path d="M8 13a2 2 0 002-2c0-1.5-2-3-2-3s-2 1.5-2 3a2 2 0 002 2z" fill="currentColor" />
  </svg>
  <span class="streak-number" id="streak-number">0</span>
</span>

<style>
  .streak-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background-color: var(--color-peach-light);
    color: var(--color-peach-dark);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .streak-icon {
    flex-shrink: 0;
  }

  html[data-theme="dark"] {
    .streak-counter {
      background-color: rgba(255, 183, 77, 0.15);
      color: var(--color-night-accent);
    }
  }
</style>

<script>
  import { loadProgress } from '../data/progress';

  try {
    const state = loadProgress();
    if (state.streak.currentStreak > 0) {
      const counter = document.getElementById('streak-counter') as HTMLElement;
      const number = document.getElementById('streak-number') as HTMLElement;
      if (counter && number) {
        number.textContent = String(state.streak.currentStreak);
        counter.style.display = 'inline-flex';
      }
    }
  } catch {}
</script>
