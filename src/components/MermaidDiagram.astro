---
interface Props {
  chart: string;
  caption?: string;
}

const { chart, caption } = Astro.props;
const diagramId = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="mermaid-container">
  <div class="mermaid-diagram" id={diagramId}>
    <pre class="mermaid-source" style="display:none;">{chart}</pre>
    <div class="mermaid-loading">
      <span>Loading diagram...</span>
    </div>
  </div>
  {caption && <figcaption class="mermaid-caption">{caption}</figcaption>}
</figure>

<style>
  .mermaid-container {
    margin: 2rem 0;
    padding: 0;
  }

  .mermaid-diagram {
    background-color: var(--color-cream-dark);
    border: 1px solid var(--color-parchment);
    border-radius: 0.75rem;
    padding: 1.5rem;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 120px;
  }

  .mermaid-diagram :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .mermaid-loading {
    color: var(--color-stone-light);
    font-size: 0.85rem;
    font-style: italic;
  }

  .mermaid-caption {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-stone);
    margin-top: 0.75rem;
    font-style: italic;
    font-family: var(--font-body);
  }

  @media (prefers-color-scheme: dark) {
    .mermaid-diagram {
      background-color: var(--color-night-surface);
      border-color: var(--color-night-elevated);
    }

    .mermaid-loading {
      color: var(--color-night-text-muted);
    }

    .mermaid-caption {
      color: var(--color-night-text-muted);
    }
  }
</style>

<script>
  async function initMermaid() {
    const mermaid = (await import('mermaid')).default;

    const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: {
        primaryColor: isDark ? '#2E2B28' : '#FAF6F1',
        primaryTextColor: isDark ? '#E8E0D6' : '#2C2825',
        primaryBorderColor: isDark ? '#D4955A' : '#B87333',
        lineColor: isDark ? '#A89E94' : '#6B6560',
        secondaryColor: isDark ? '#242120' : '#F0EAE0',
        tertiaryColor: isDark ? '#1A1816' : '#EDE7DC',
        noteBkgColor: isDark ? '#2E2B28' : '#EDE7DC',
        noteTextColor: isDark ? '#E8E0D6' : '#2C2825',
        noteBorderColor: isDark ? '#D4955A' : '#B87333',
        actorBkg: isDark ? '#2E2B28' : '#FAF6F1',
        actorBorder: isDark ? '#D4955A' : '#B87333',
        actorTextColor: isDark ? '#E8E0D6' : '#2C2825',
        signalColor: isDark ? '#E8E0D6' : '#2C2825',
        signalTextColor: isDark ? '#E8E0D6' : '#2C2825',
        labelBoxBkgColor: isDark ? '#2E2B28' : '#FAF6F1',
        labelBoxBorderColor: isDark ? '#D4955A' : '#B87333',
        labelTextColor: isDark ? '#E8E0D6' : '#2C2825',
        fontFamily: 'Source Sans 3, system-ui, sans-serif',
        fontSize: '14px',
      },
    });

    const containers = document.querySelectorAll('.mermaid-diagram');
    for (const container of containers) {
      const source = container.querySelector('.mermaid-source');
      const loading = container.querySelector('.mermaid-loading');
      if (!source) continue;

      const chartDef = source.textContent?.trim();
      if (!chartDef) continue;

      try {
        const id = container.id || `mermaid-${Math.random().toString(36).slice(2, 9)}`;
        const { svg } = await mermaid.render(id + '-svg', chartDef);
        if (loading) loading.remove();
        source.remove();
        container.insertAdjacentHTML('beforeend', svg);
      } catch (err) {
        console.error('Mermaid render error:', err);
        if (loading) {
          loading.innerHTML = '<span style="color: var(--color-copper);">Diagram could not be rendered.</span>';
        }
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaid);
  } else {
    initMermaid();
  }
</script>
