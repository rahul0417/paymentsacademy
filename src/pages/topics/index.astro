---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicCard from '../../components/TopicCard.astro';
import { getCollection } from 'astro:content';

// Fetch published topics
const allTopics = await getCollection('topics');

// Define theme order (same as homepage)
const themes = [
  {
    name: 'Foundations',
    description: 'Core concepts that underpin the entire payments ecosystem.',
  },
  {
    name: 'Transaction Lifecycle',
    description: 'Follow a payment from initiation to final settlement.',
  },
  {
    name: 'Card Ecosystem',
    description: 'The networks, banks, and economics behind every card payment.',
  },
  {
    name: 'Non-Card Payments',
    description: 'Payment methods beyond plastic — from bank transfers to crypto.',
  },
  {
    name: 'Moving Money',
    description: 'How funds travel across borders, banks, and networks.',
  },
  {
    name: 'Products & Use Cases',
    description: 'Real-world applications built on payments infrastructure.',
  },
  {
    name: 'Trust & Compliance',
    description: 'The rules, risks, and safeguards that keep payments secure.',
  },
];

// Group published topics by theme
const topicsByTheme = new Map<string, typeof allTopics>();
for (const topic of allTopics) {
  const theme = topic.data.theme;
  if (!topicsByTheme.has(theme)) {
    topicsByTheme.set(theme, []);
  }
  topicsByTheme.get(theme)!.push(topic);
}

// Sort topics within each theme by order
for (const [, topics] of topicsByTheme) {
  topics.sort((a, b) => a.data.order - b.data.order);
}

const totalTopics = allTopics.length;
---

<BaseLayout
  title="All Topics — FintechAcademy"
  description="Browse all payments topics grouped by theme. From foundations to compliance, explore the entire payments ecosystem."
>
  <section class="topics-section">
    <div class="topics-container">
      <div class="topics-header">
        <h1 class="topics-heading">All Topics</h1>
        <p class="topics-count">{totalTopics} {totalTopics === 1 ? 'topic' : 'topics'} across {themes.length} themes</p>
        <p class="topics-intro">
          Explore the payments ecosystem, one concept at a time. Each topic is a
          self-contained guide written in plain language.
        </p>
      </div>

      {themes.map((theme, themeIndex) => {
        const publishedTopics = topicsByTheme.get(theme.name) || [];

        return (
          <div
            class="theme-group"
            style={`animation-delay: ${0.1 + themeIndex * 0.08}s;`}
          >
            <div class="theme-header">
              <h2 class="theme-name">{theme.name}</h2>
              <p class="theme-description">{theme.description}</p>
            </div>

            <div class="topic-grid">
              {publishedTopics.map((topic) => (
                <TopicCard
                  title={topic.data.title}
                  description={topic.data.description}
                  theme={topic.data.theme}
                  readingTime={topic.data.readingTime}
                  href={`/topics/${topic.id}`}
                />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  /* Topics Section */
  .topics-section {
    padding: 3rem 1.5rem 5rem;
  }

  .topics-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .topics-header {
    text-align: center;
    margin-bottom: 3.5rem;
    animation: fadeInUp 0.6s ease both;
  }

  .topics-heading {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .topics-count {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .topics-intro {
    font-size: 1.05rem;
    color: var(--color-text-medium);
    max-width: 32rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Theme Groups */
  .theme-group {
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s ease both;
  }

  .theme-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-pale-mint-dark);
  }

  .theme-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-racing-green);
    margin-bottom: 0.25rem;
  }

  .theme-description {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  /* Topic Grid */
  .topic-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .topic-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Dark mode */
  html[data-theme="dark"] {
    .topics-heading {
      color: var(--color-night-text);
    }

    .topics-count {
      color: var(--color-night-text-muted);
    }

    .topics-intro {
      color: var(--color-night-text-muted);
    }

    .theme-name {
      color: var(--color-night-text);
    }

    .theme-description {
      color: var(--color-night-text-muted);
    }

    .theme-header {
      border-bottom-color: var(--color-night-elevated);
    }
  }

  /* Responsive */
  @media (min-width: 768px) {
    .topics-section {
      padding: 4rem 2rem 6rem;
    }

    .topics-heading {
      font-size: 2.75rem;
    }
  }
</style>
