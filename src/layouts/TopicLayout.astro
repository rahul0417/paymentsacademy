---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import RelatedTopics from '../components/RelatedTopics.astro';
import PathNav from '../components/PathNav.astro';
import Quiz from '../components/Quiz.astro';
import { getPathForSlug } from '../data/learning-paths';
import { getQuizBySlug } from '../data/quizzes';
import { getMicroLessonBySlug } from '../data/microlearning';

interface Props {
  title: string;
  description: string;
  theme: string;
  readingTime: string;
  order: number;
  relatedTopics?: string[];
  glossaryTerms?: { term: string; definition: string }[];
  slug: string;
}

const {
  title,
  description,
  theme,
  readingTime,
  relatedTopics = [],
  slug,
} = Astro.props;

const themeColors: Record<string, string> = {
  'Foundations': 'var(--color-racing-green)',
  'Transaction Lifecycle': 'var(--color-peach-dark)',
  'Card Ecosystem': 'var(--color-peach-dark)',
  'Non-Card Payments': 'var(--color-racing-green-light)',
  'Moving Money': 'var(--color-racing-green)',
  'Products & Use Cases': 'var(--color-peach)',
  'Trust & Compliance': 'var(--color-text-medium)',
};

const badgeColor = themeColors[theme] || 'var(--color-text-medium)';

const pathInfo = getPathForSlug(slug);
const hasQuiz = !!getQuizBySlug(slug);
const hasMicroLesson = !!getMicroLessonBySlug(slug);
---

<BaseLayout title={title} description={description}>
  <div class="topic-page" data-topic-slug={slug}>
    <Sidebar currentSlug={slug} />

    <article class="topic-content">
      <!-- Article header -->
      <header class="topic-header">
        <div class="topic-meta">
          <span class="theme-badge" style={`color: ${badgeColor}`}>{theme}</span>
          <span class="reading-time">{readingTime}</span>
        </div>
        <h1 class="topic-title">{title}</h1>
        <div class="tldr-box">
          <span class="tldr-label">TL;DR</span>
          <p class="tldr-text">{description}</p>
        </div>
        {hasMicroLesson && (
          <a href={`/micro/review/${slug}`} class="micro-learning-cta">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="14" height="12" rx="2" />
              <path d="M6 7h6M6 10h4" />
            </svg>
            Learn this topic in Micro Learning
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 3l4 4-4 4" />
            </svg>
          </a>
        )}
      </header>

      <!-- Article body -->
      <div class="prose prose-lg">
        <slot />
      </div>

      <!-- Review links -->
      <div class="micro-links">
        {hasMicroLesson && (
          <a href={`/micro/review/${slug}`} class="micro-link">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="14" height="12" rx="2" />
              <path d="M6 7h6M6 10h4" />
            </svg>
            Micro Learning
          </a>
        )}
        {hasQuiz && (
          <a href={`#topic-quiz`} class="micro-link">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="7" />
              <path d="M7 7a2 2 0 013.5 0.7c0 1.3-2 2-2 2" />
              <circle cx="9" cy="12.5" r="0.4" fill="currentColor" />
            </svg>
            Take the quiz
          </a>
        )}
      </div>

      <!-- Quiz -->
      <Quiz topicSlug={slug} />

      <!-- Related topics -->
      {relatedTopics.length > 0 && (
        <RelatedTopics slugs={relatedTopics} />
      )}

      {pathInfo && (
        <PathNav
          pathId={pathInfo.path.id}
          pathTitle={pathInfo.path.title}
          pathNumeral={pathInfo.path.numeral}
          currentIndex={pathInfo.stepIndex}
          totalSteps={pathInfo.path.steps.length}
          prevStep={pathInfo.stepIndex > 0 ? pathInfo.path.steps[pathInfo.stepIndex - 1] : null}
          nextStep={pathInfo.stepIndex < pathInfo.path.steps.length - 1 ? pathInfo.path.steps[pathInfo.stepIndex + 1] : null}
        />
      )}
    </article>
  </div>

  <!-- Mobile sidebar toggle -->
  <button
    type="button"
    class="sidebar-mobile-toggle"
    id="sidebar-toggle"
    aria-label="Open topic navigation"
    aria-controls="sidebar-mobile"
    aria-expanded="false"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M3 5h14M3 10h10M3 15h12" />
    </svg>
    <span>Topics</span>
  </button>

  <!-- Mobile sidebar overlay -->
  <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>
  <div class="sidebar-mobile" id="sidebar-mobile" aria-hidden="true" hidden>
    <div class="sidebar-mobile-header">
      <span class="font-heading font-semibold">Navigate</span>
      <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Close navigation">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M4 4l10 10M14 4L4 14" />
        </svg>
      </button>
    </div>
    <Sidebar currentSlug={slug} />
  </div>
</BaseLayout>

<style>
  .topic-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  .topic-content {
    flex: 1;
    min-width: 0;
    max-width: 70ch;
  }

  .topic-header {
    margin-bottom: 2.5rem;
  }

  .topic-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .theme-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .reading-time {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .topic-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-racing-green);
    margin: 0 0 1.5rem 0;
  }

  .tldr-box {
    background-color: var(--color-pale-mint);
    border-left: 3px solid var(--color-peach);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 1rem 1.25rem;
  }

  .tldr-label {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-peach-dark);
    margin-bottom: 0.25rem;
  }

  .tldr-text {
    font-size: 0.95rem;
    color: var(--color-text-medium);
    margin: 0;
    line-height: 1.6;
  }

  .micro-learning-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.7rem 1.25rem;
    background-color: var(--color-pale-mint);
    border: 1.5px solid var(--color-racing-green-light);
    border-radius: 0.5rem;
    color: var(--color-racing-green);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .micro-learning-cta:hover {
    background-color: var(--color-racing-green);
    border-color: var(--color-racing-green);
    color: var(--color-white);
  }

  .micro-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding: 1.25rem;
    background-color: var(--color-pale-mint);
    border-radius: 0.75rem;
  }

  .micro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-racing-green);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .micro-link:hover {
    color: var(--color-racing-green-light);
  }

  /* Mobile sidebar toggle button */
  .sidebar-mobile-toggle {
    display: none;
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 40;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background-color: var(--color-racing-green);
    color: var(--color-white);
    border: none;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(13, 77, 43, 0.2);
    transition: background-color 0.2s ease;
  }

  .sidebar-mobile-toggle:hover {
    background-color: var(--color-racing-green-light);
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 45;
  }

  .sidebar-overlay.open {
    display: block;
  }

  .sidebar-mobile {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    z-index: 50;
    background-color: var(--color-white);
    border-right: 1px solid var(--color-pale-mint-dark);
    padding: 1.25rem;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .sidebar-mobile.open {
    transform: translateX(0);
  }

  .sidebar-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-pale-mint-dark);
  }

  .sidebar-close {
    padding: 0.25rem;
    background: none;
    border: none;
    color: var(--color-text-light);
    cursor: pointer;
    border-radius: 0.25rem;
    transition: color 0.2s ease;
  }

  .sidebar-close:hover {
    color: var(--color-racing-green);
  }

  /* Force nested sidebar to show in mobile drawer */
  .sidebar-mobile :global(.sidebar) {
    display: block !important;
    position: static;
    width: 100%;
    max-height: none;
    padding-right: 0;
  }

  @media (max-width: 1023px) {
    .sidebar-mobile-toggle {
      display: flex;
    }

    .sidebar-mobile {
      display: block;
    }

    .topic-page {
      padding: 1.5rem 1rem;
    }

    .topic-title {
      font-size: 2rem;
    }
  }

  html[data-theme="dark"] {
    .topic-title {
      color: var(--color-night-text);
    }

    .reading-time {
      color: var(--color-night-text-muted);
    }

    .tldr-box {
      background-color: var(--color-night-surface);
      border-left-color: var(--color-night-accent);
    }

    .tldr-label {
      color: var(--color-night-accent);
    }

    .tldr-text {
      color: var(--color-night-text-muted);
    }

    .sidebar-mobile-toggle {
      background-color: var(--color-night-elevated);
      color: var(--color-night-text);
    }

    .sidebar-mobile-toggle:hover {
      background-color: var(--color-night-surface);
    }

    .sidebar-mobile {
      background-color: var(--color-night);
      border-right-color: var(--color-night-elevated);
    }

    .sidebar-mobile-header {
      border-bottom-color: var(--color-night-elevated);
    }

    .sidebar-close {
      color: var(--color-night-text-muted);
    }

    .sidebar-close:hover {
      color: var(--color-night-text);
    }

    .micro-learning-cta {
      background-color: var(--color-night-surface);
      border-color: var(--color-night-elevated);
      color: var(--color-night-accent);
    }

    .micro-learning-cta:hover {
      background-color: var(--color-night-accent);
      border-color: var(--color-night-accent);
      color: var(--color-night);
    }

    .micro-links {
      background-color: var(--color-night-surface);
    }

    .micro-link {
      color: var(--color-night-accent);
    }

    .micro-link:hover {
      color: var(--color-peach-dark);
    }
  }
</style>

<script>
  let lastFocusedElement: HTMLElement | null = null;

  const toggle = document.getElementById('sidebar-toggle');
  const overlay = document.getElementById('sidebar-overlay');
  const mobile = document.getElementById('sidebar-mobile');
  const close = document.getElementById('sidebar-close');
  const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function openSidebar() {
    lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    mobile?.removeAttribute('hidden');
    overlay?.classList.add('open');
    mobile?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
    mobile?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      (close || mobile?.querySelector(focusableSelector))?.focus();
    });
  }

  function closeSidebar() {
    overlay?.classList.remove('open');
    mobile?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    mobile?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    window.setTimeout(() => mobile?.setAttribute('hidden', ''), 300);
    lastFocusedElement?.focus();
  }

  toggle?.addEventListener('click', openSidebar);
  overlay?.addEventListener('click', closeSidebar);
  close?.addEventListener('click', closeSidebar);

  document.addEventListener('keydown', (event) => {
    if (!mobile?.classList.contains('open')) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeSidebar();
      return;
    }

    if (event.key !== 'Tab') return;

    const focusable = Array.from(mobile.querySelectorAll<HTMLElement>(focusableSelector));
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>

<script>
  import { markTopicRead } from '../data/progress';

  const topicPage = document.querySelector('.topic-page[data-topic-slug]') as HTMLElement | null;
  const topicSlug = topicPage?.dataset.topicSlug;

  if (topicSlug) {
    markTopicRead(topicSlug);
  }
</script>
